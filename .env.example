# Copy these into your terminal environment or a local .env file loaded by your setup.
# Do not commit real secrets to GitHub.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
COLLEGE_EMAIL_DOMAIN=psnacet.edu.in

# SMTP settings are required to send real OTP emails.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587
# Use an app password if your provider requires one; never use your normal email password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=replace-with-your-gmail-app-password
SMTP_FROM=your-email@example.com

# Keep 0 for local HTTP development. Set 1 only when deployed behind HTTPS.
COOKIE_SECURE=0
